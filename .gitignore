KEYDB.cfg
*.keydb

# Python
# uv's lock file is committed, unlike the rip work files' lock files above.
!/uv.lock
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

